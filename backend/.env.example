# Variáveis de ambiente do backend AWS Simulado

# MongoDB
MONGODB_URI=mongodb://localhost:27017/aws-simulado

# Servidor
PORT=3001

# CORS — origem do front-end Next.js (separar múltiplas com vírgula)
CORS_ORIGIN=http://localhost:3000

# Proteção de rotas de escrita — gere uma chave aleatória segura
API_KEY=troque-por-uma-chave-segura-uuid-aqui

# (Opcional) API Anthropic — necessária apenas para importação LLM de PDFs
ANTHROPIC_API_KEY=sk-ant-...
